# セキュリティ的にデータベース設定は個々人で変えるのが吉
# データベース設定(仮)
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=trial-db

# ホスト名 (docker-composeのサービス名)
DB_HOST=db
DB_PORT=5432

# バックエンド設定
BACKEND_PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=public
FRONTEND_URL=http://localhost:5173

# フロントエンド設定
FRONTEND_PORT=5173
# ブラウザから見たAPIのURL (ホスト側のポート)
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
# サーバーから見たAPIのURL (Docker内部のURL)
INTERNAL_API_URL=http://backend:3000
